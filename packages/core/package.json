{
  "name": "@mycluster/core",
  "version": "0.1.0",
  "description": "Core orchestration engine for MyCluster distributed compute",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js",
    "./discovery": "./dist/discovery.js",
    "./storage": "./dist/storage-memory.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cluster",
    "orchestration",
    "lan"
  ],
  "author": "Leafdriving",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.19.11",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
