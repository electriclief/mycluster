{
  "name": "@mycluster/e2e",
  "version": "0.1.0",
  "description": "End-to-end tests for MyCluster",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:api": "vitest run tests/api",
    "test:integration": "vitest run tests/integration",
    "test:benchmark": "tsx tests/benchmark/job-queue.benchmark.ts",
    "test:all": "npm run test:integration && npm run test:api && npm run test:benchmark"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@types/node": "^22.13.9",
    "tsx": "^4.7.0",
    "typescript": "^5.7.3",
    "vitest": "^1.3.0"
  },
  "dependencies": {
    "@mycluster/core": "^0.1.0",
    "@mycluster/server": "^0.1.0"
  }
}
