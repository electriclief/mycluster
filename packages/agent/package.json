{
  "name": "@mycluster/agent",
  "version": "0.1.0",
  "description": "Agent CLI for executing Python scripts on remote machines",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mycluster-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["agent", "mycluster", "python", "executor"],
  "author": "Leafdriving",
  "license": "MIT",
  "dependencies": {
    "@mycluster/core": "^0.1.0",
    "commander": "^12.0.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.7.3"
  }
}
